  "rules": [
    {
      "rule": "To change the properties (color, stroke, etc.) of an existing object, you must first select it using the Selection tool (V).",
      "source": "exploration",
      "confidence": 0.8,
      "supporting_runs": []
    },
    {
      "rule": "To set properties for new objects, you can select a drawing tool (e.g., Rectangle) and then configure its properties from the left-hand panel *before* drawing.",
      "source": "exploration",
      "confidence": 0.8,
      "supporting_runs": []
    },
    {
      "rule": "To add text inside a shape, select the shape and press Enter or double-click it.",
      "source": "exploration",
      "confidence": 0.8,
      "supporting_runs": []
    },
    {
      "rule": "To create a multi-point line or arrow, select the tool and click at different points on the canvas instead of dragging.",
      "source": "exploration",
      "confidence": 0.8,
      "supporting_runs": []
    },
    {
      "rule": "To select multiple objects, either drag a selection box that completely encloses all objects or hold Shift and click on each object individually.",
      "source": "exploration",
      "confidence": 0.8,
      "supporting_runs": []
    },
    {
      "rule": "Clearing the canvas is an irreversible action. There is no way to restore a cleared canvas.",
      "source": "exploration",
      "confidence": 0.8,
      "supporting_runs": []
    },
    {
      "rule": "The standard selection box only selects objects that are *entirely* contained within it, not just touching it.",
      "source": "web_research",
      "confidence": 0.95,
      "supporting_runs": []
    },
    {
      "rule": "Clearing the canvas via the menu or shortcut (Ctrl+Delete) is permanent and cannot be undone with the Undo command.",
      "source": "web_research",
      "confidence": 0.95,
      "supporting_runs": []
    },
    {
      "rule": "When drawing shapes like rectangles or ellipses, holding Shift is required to maintain a 1:1 aspect ratio (to create a perfect square or circle).",
      "source": "web_research",
      "confidence": 0.95,
      "supporting_runs": []
    },
    {
      "rule": "Pasting an image from your clipboard can be done directly onto the canvas with Ctrl/Cmd+V.",
      "source": "web_research",
      "confidence": 0.95,
      "supporting_runs": []
    },
    {
      "rule": "Exiting the text editor requires pressing Escape or clicking outside the text box. Simply pressing Enter will create a new line.",
      "source": "web_research",
      "confidence": 0.95,
      "supporting_runs": []
    },
    {
      "rule": "Arrows will automatically snap and bind to the edges of other shapes. This can be helpful but may require careful positioning if you want to avoid it.",
      "source": "web_research",
      "confidence": 0.95,
      "supporting_runs": []
    }
  ],
